body {
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 0;
    background-color: #f4f6f9;
    color: #333;
}
header {
    background-color: #2c3e50;
    color: white;
    text-align: center;
    padding: 20px;
}
nav {
    background-color: #34495e;
    padding: 10px;
    text-align: center;
}
nav a {
    color: white;
    text-decoration: none;
    margin: 0 15px;
    font-weight: bold;
    font-size: 16px;
}
nav a:hover {
    color: #3498db;
}
.container {
    max-width: 900px;
    margin: 30px auto;
    background: white;
    padding: 30px;
    border-radius: 8px;
    box-shadow: 0 4px 8px rgba(0,0,0,0.1);
}
.member-card {
    background: #ecf0f1;
    padding: 15px;
    margin-bottom: 15px;
    border-radius: 6px;
    border-left: 5px solid #3498db;
}
footer {
    text-align: center;
    padding: 15px;
    background-color: #2c3e50;
    color: white;
    margin-top: 40px;
}